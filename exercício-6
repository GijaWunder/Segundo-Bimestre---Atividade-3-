programa
{
	
	funcao inicio()
	{
		inteiro numero1
		inteiro numero2
		inteiro numero3
		inteiro numero4
		

		escreva("Informe um número: ")
		leia(numero1)

		escreva("Informe outro número: ")
		leia(numero2)

		escreva("Informe outro número: ")
		leia(numero3)

		escreva("Informe outro número: ")
		leia(numero4)

		se(numero1 > numero2 e numero1 > numero3 e numero1 > numero4){
		escreva("O ", numero1, " é o maior número")

		}
		se(numero2 > numero1 e numero2 > numero3 e numero2 > numero4){
		escreva("O ", numero2, " é o maior número")

		}

		se(numero3 > numero1 e numero3 > numero2 e numero3 > numero4){
		escreva("O ", numero3, " é o maior número")
		}

		se(numero4 > numero1 e numero4 > numero3 e numero4 > numero2){
		escreva("O ", numero4, " é o maior número")

		}
	}
}
